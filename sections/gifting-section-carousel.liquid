{% comment %}
  Gifting Hero + Product Slider (Flickity - Single centered square with hover-swap)
  - Option A: 1 product visible at a time (square)
  - Hover: fade from first image → second image (Tailwind classes only)
  - Custom external arrows (left/right)
  - Uses Flickity already included in theme.liquid
  - If no hero_image is set, uses uploaded preview image path as fallback
{% endcomment %}

{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

<style>
  /* Tight control for Flickity cell width to keep one centered cell */
  .carousel-main-{{ section.id }} {
    /* allow Flickity to control centering */
    display: block;
  }

  /* center the single cell and prevent it from stretching too wide on large screens */
  .carousel-main-{{ section.id }} .carousel-cell {
    width: 100%; /* desktop default size for the square card — adjust as needed */
    max-width: 38vw; /* responsive cap */
    margin: 0 12px;
  }

  @media (max-width: 1024px) {
    .carousel-main-{{ section.id }} .carousel-cell {
      width: 320px;
      max-width: 46vw;
    }
  }

  @media (max-width: 640px) {
    .carousel-main-{{ section.id }} .carousel-cell {
      width: 80vw;
      max-width: 80vw;
      margin: 0 8px;
    }
  }

  /* Remove Flickity internal button visuals if present */
  .carousel-main-{{ section.id }} .flickity-button {
    background: none;
    border: none;
    box-shadow: none;
  }
</style>

<section class="bg-[#ABCBAA] py-10">
  <div class="max-w-[{{ section.settings.container_width }}px] mx-auto px-4">
    <div class="flex flex-wrap items-stretch gap-8">
      <!-- LEFT: Hero image (large) -->
      <div class="flex-1 min-w-[320px]">
        {% if section.settings.hero_image %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 2000 }}"
            alt="{{ section.settings.hero_heading | escape }}"
            class="w-full h-full object-cover block"
          >
        {% else %}
          <!-- fallback to uploaded preview image path -->
          <img
            src="/mnt/data/9716f8ff-a24b-4122-9cc2-5eb0801655bc.png"
            alt="hero fallback"
            class="w-full h-full object-cover block"
          >
        {% endif %}
      </div>

      <!-- RIGHT: Centered single-item slider + text -->
      <div class="w-1/3 min-w-[300px] flex flex-col items-center">
        {% assign products = section.settings.carousel_collection.products %}
        {% if products.size > 0 %}
          <div class="w-full flex items-center">
            <!-- Prev button -->
            <button
              type="button"
              class="flickity-prev-{{ section.id }} flex items-center justify-center w-28 h-28 cursor-pointer ml-4 bg-transparent"
              aria-label="Previous"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="0.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-chevron-right-icon lucide-chevron-right w-full h-full rotate-180"
              >
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </button>

            <!-- Flickity container -->
            <div class="carousel-main-{{ section.id }} w-full overflow-hidden shadow-none">
              {% for product in products %}
                <div class="carousel-cell">
                  <!-- outer panel (beige background like screenshot) -->
                  <div class="p-24 flex items-center justify-center">
                    <!-- square image wrapper: uses padding-bottom to enforce 1:1 aspect ratio -->
                    <div class=" group relative w-full overflow-hidden" style="padding-bottom:100%;">
                      <a href="{{ product.url }}" class="block">
                        {% assign first = product.featured_image %}
                        {% if first %}
                          <img
                            src="{{ first | image_url: width: 900 }}"
                            alt="{{ product.title | escape }}"
                            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300 ease-linear"
                          >
                        {% endif %}

                        {% assign second = product.images[1] %}
                        {% if second %}
                          <!-- use group-hover to trigger opacity change using Tailwind only -->
                          <img
                            src="{{ second | image_url: width: 900 }}"
                            alt="{{ product.title | escape }} - alt"
                            class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 ease-linear group-hover:opacity-100"
                          >
                        {% endif %}
                      </a>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            <!-- Next button -->
            <button
              type="button"
              class="flickity-next-{{ section.id }} flex items-center justify-center w-28 h-28 cursor-pointer ml-4 bg-transparent"
              aria-label="Next"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="0.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-chevron-right-icon lucide-chevron-right w-full h-full"
              >
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </button>
          </div>
        {% endif %}

        <!-- Text + CTA below slider -->
        <div class="flex flex-col justify-center gap-4 mt-8 text-center px-4">
          <h2 class="font-montserrat text-4xl font-semibold text-[#273A27]">
            {{ section.settings.hero_heading }}
          </h2>
          <p class="text-[#273A27] text-2xl py-2">
            {{ section.settings.hero_subtext }}
          </p>

          {% if section.settings.explore_collection %}
            <a
              href="{{ section.settings.explore_collection.url }}"
              class="
                w-fit mx-auto font-montserrat inline-block border-[1px] border-[#273A27] text-[#273A27]
                uppercase px-7 py-3 font-semibold transition
              "
            >
              {{ section.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sliderEl = document.querySelector('.carousel-main-{{ section.id }}');
    var prevBtn = document.querySelector('.flickity-prev-{{ section.id }}');
    var nextBtn = document.querySelector('.flickity-next-{{ section.id }}');

    if (!sliderEl) return;
    var cells = sliderEl.querySelectorAll('.carousel-cell');
    if (!cells || cells.length === 0) return;

    // Initialize Flickity with one centered cell at a time
    var flkty = new Flickity(sliderEl, {
      wrapAround: true,
      pageDots: false,
      prevNextButtons: false, // we use external buttons
      contain: true,
      cellAlign: 'center',
      draggable: true,
      groupCells: false,
      adaptiveHeight: false,
      selectedAttraction: 0.02,
      friction: 0.3,
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        flkty.previous();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        flkty.next();
      });
    }

    // Ensure Flickity recalculates on resize
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        flkty.resize();
      }, 120);
    });
  });
</script>

{% schema %}
{
  "name": "Gifting product slider",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Left hero image" },

    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Wedding Gifting" },

    {
      "type": "textarea",
      "id": "hero_subtext",
      "label": "Subtext",
      "default": "Beautifully packaged, perfectly picked – Celebrate the new beginning with thoughtfully curated wedding gifts."
    },

    { "type": "collection", "id": "explore_collection", "label": "Explore button collection" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "EXPLORE" },

    { "type": "collection", "id": "carousel_collection", "label": "Product collection (slider)" },

    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1400
    },

    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image ratio",
      "min": 60,
      "max": 150,
      "step": 1,
      "default": 100
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 44,
      "default": 34
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#6b5b4e" },

    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext size",
      "min": 12,
      "max": 20,
      "default": 14
    },
    { "type": "color", "id": "subtext_color", "label": "Subtext color", "default": "#555555" },

    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 24,
      "default": 8
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Card text alignment",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "right" }
      ],
      "default": "center"
    }
  ],
  "presets": [{ "name": "Gifting product slider" }]
}
{% endschema %}
