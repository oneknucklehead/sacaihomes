{% comment %}
  Luxury Product Carousel with hover second image + buttons
{% endcomment %}

<div class="product-carousel-section bg-[#ABCBAA] py-14">
  <div class="mx-auto px-4">
    {% if section.settings.heading != blank %}
      <h2 class="font-montserrat text-center my-10 text-5xl font-semibold">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="flex items-center">
      <!-- Prev Button -->
      <button
        class="basis-1/12 cursor-pointer flickity-prev-{{ section.id }} text-black w-14 h-14 flex items-center justify-center"
        aria-label="Prev"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="80"
          height="80"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="0.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-chevron-left-icon lucide-chevron-left"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>

      <!-- Flickity Carousel -->
      <div class="basis-11/12 carousel-main-{{ section.id }} flickity-slider-{{ section.id }}">
        {% for product in collections[section.settings.collection].products %}
          <div class="carousel-cell w-full">
            <a href="{{ product.url }}" class="block overflow-hidden group">
              <div class="w-full relative pb-[100%] bg-[#E9E6DD] overflow-hidden">
                {% assign first_image = product.images[0] %}
                {% assign second_image = product.images[1] %}

                <!-- First Image -->
                <img
                  src="{{ first_image | img_url: '800x800' }}"
                  alt="{{ product.title | escape }}"
                  class="
                    absolute inset-0 w-full h-full object-cover transition-opacity duration-500
                    {% if second_image %}group-hover:opacity-0{% endif %}
                  "
                >

                <!-- Second Image -->
                {% if second_image %}
                  <img
                    src="{{ second_image | img_url: '800x800' }}"
                    alt="{{ product.title | escape }}"
                    class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                  >
                {% endif %}

                <!-- Hover Buttons -->
                <div
                  class="
                    absolute bottom-0 left-0 right-0 bg-white bg-opacity-90 flex justify-center space-x-8 py-3
                    opacity-0 group-hover:opacity-100 transition-all duration-500
                  "
                >
                  <button
                    class="add-to-bag-btn text-sm font-medium tracking-wide text-[#273A27] hover:underline"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    ADD TO BAG
                  </button>

                  <span class="text-gray-400">|</span>

                  <button
                    class="buy-now-btn text-sm font-medium tracking-wide text-[#273A27] hover:underline"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    BUY NOW
                  </button>
                </div>
              </div>

              <!-- Title + Price -->
              <div class="text-center mt-4">
                <h3 class="text-sm tracking-[0.15em] font-medium text-[#273A27] uppercase">
                  {{ product.title }}
                </h3>
                <p class="text-[#273A27] mt-1 text-sm">
                  {{ product.price | money }}
                </p>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>

      <!-- Next Button -->
      <button
        class="basis-1/12 cursor-pointer flickity-next-{{ section.id }} text-black w-14 h-14 flex items-center justify-center"
        aria-label="Next"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="80"
          height="80"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="0.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-chevron-right-icon lucide-chevron-right"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* Desktop: 3 items */
  .flickity-slider-{{ section.id }} .carousel-cell {
    width: calc((100% - 40px) / 3);
    margin-right: 20px;
  }

  /* Tablet: 2 items */
  @media (max-width: 989px) {
    .flickity-slider-{{ section.id }} .carousel-cell {
      width: calc((100% - 20px) / 2);
    }
  }

  /* Mobile: 1 item */
  @media (max-width: 749px) {
    .flickity-slider-{{ section.id }} .carousel-cell {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('.carousel-main-{{ section.id }}');
    var prevBtn = document.querySelector('.flickity-prev-{{ section.id }}');
    var nextBtn = document.querySelector('.flickity-next-{{ section.id }}');

    if (!slider) return;

    var flkty = new Flickity(slider, {
      wrapAround: true,
      pageDots: false,
      prevNextButtons: false,
      contain: true,
      cellAlign: 'left',
      groupCells: true,
      draggable: true,
      selectedAttraction: 0.015,
      friction: 0.25,
    });

    if (prevBtn) prevBtn.addEventListener('click', () => flkty.previous());
    if (nextBtn) nextBtn.addEventListener('click', () => flkty.next());

    window.addEventListener('resize', () => flkty.resize());
  });
</script>

{% schema %}
{
  "name": "Luxury Product Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [{ "name": "Luxury Product Carousel" }]
}
{% endschema %}
