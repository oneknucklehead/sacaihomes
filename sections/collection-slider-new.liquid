<div class="collection-slider flickity-slider-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="font-montserrat text-center my-10 text-5xl font-semibold">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <!-- Slider Container -->
  <div class="flex items-center">
    <button
      class="basis-1/12 cursor-pointer flickity-prev-{{ section.id }} text-black w-14 h-14 flex items-center justify-center"
      aria-label="Prev"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="80"
        height="80"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="0.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-chevron-left-icon lucide-chevron-left"
      >
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>
    <div
      class="basis-11/12 carousel-main-{{ section.id }}"
    >
      {% for collection in section.settings.collections %}
        <div class="carousel-cell w-full">
          <a href="{{ collection.url }}" class="block overflow-hidden">
            <div class="w-full relative pb-[100%] bg-gray-100 overflow-hidden">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  class="absolute inset-0 w-full h-full object-cover"
                  alt="{{ collection.title }}"
                >
              {% endif %}
            </div>
            <div class="p-4 font-bold text-[#273A27] text-2xl  text-center flex gap-2 items-center justify-center">
              <h3 class="uppercase">
                {{ collection.title }}
              </h3>
              <span class="">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-chevron-right-icon lucide-chevron-right"
                >
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </span>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
    <button
      class="basis-1/12 cursor-pointer flickity-next-{{ section.id }} text-black w-14 h-14 flex items-center justify-center"
      aria-label="Next"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="80"
        height="80"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="0.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-chevron-right-icon lucide-chevron-right"
      >
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .flickity-slider-{{ section.id }} .carousel-cell {
    width: calc((100% - 40px) / 3);
    margin-right: 20px;
  }

  @media (max-width: 989px) {
    .flickity-slider-{{ section.id }} .carousel-cell {
      width: calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 749px) {
    .flickity-slider-{{ section.id }} .carousel-cell {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('.carousel-main-{{ section.id }}');
    var prevBtn = document.querySelector('.flickity-prev-{{ section.id }}');
    var nextBtn = document.querySelector('.flickity-next-{{ section.id }}');

    // Safety: must have slider and at least one cell
    if (!slider) return;
    var cells = slider.querySelectorAll('.carousel-cell');
    if (!cells || cells.length === 0) return;

    // Create Flickity instance
    var flkty = new Flickity(slider, {
      wrapAround: true,
      pageDots: false,
      prevNextButtons: false, // using custom external buttons
      contain: true,
      cellAlign: 'left', // <-- must be a string
      draggable: true,
      groupCells: true,
      selectedAttraction: 0.015, // smoother easing
      friction: 0.25, // smoother stopping
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        flkty.previous();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        flkty.next();
      });
    }

    // Recalculate on resize (ensures contain & centering adapt)
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        flkty.resize();
      }, 120);
    });
  });
</script>

{% schema %}
{
  "name": "CollectionFlickity slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 20
    }
  ],
  "presets": [
    {
      "name": "CollectionFlickity slider"
    }
  ]
}
{% endschema %}
