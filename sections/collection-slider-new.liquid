<div class="collection-slider flickity-slider-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="text-center my-10 text-3xl font-semibold">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <!-- Slider Container -->
  <div
    class="carousel-main-{{ section.id }}"
    data-flickity='
      {
        "wrapAround": true,
        "pageDots": false,
        "prevNextButtons": false,
        "cellAlign": "left",
        "contain": true
      }
    '
  >
    {% for collection in section.settings.collections %}
      <div class="carousel-cell w-full">
        <a href="{{ collection.url }}" class="block rounded-xl overflow-hidden shadow-sm">
          <div class="w-full relative pb-[100%] bg-gray-100 overflow-hidden">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                class="absolute inset-0 w-full h-full object-cover"
                alt="{{ collection.title }}"
              >
            {% endif %}
          </div>
          <div class="p-4 text-center">
            <h3 class="text-lg font-semibold">{{ collection.title }}</h3>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

  <!-- Navigation Buttons -->
  <div class="flex justify-between items-center mt-6 px-4 relative">
    <button
      class="flickity-prev-{{ section.id }} text-black w-14 h-14 flex items-center justify-center"
      aria-label="Prev"
    >
      <svg width="40" height="40" fill="none" stroke="currentColor">
        <path d="M15 18l-6-6 6-6" stroke-width="2"/>
      </svg>
    </button>

    <button
      class="flickity-next-{{ section.id }} text-black w-14 h-14 flex items-center justify-center"
      aria-label="Next"
    >
      <svg width="40" height="40" fill="none" stroke="currentColor">
        <path d="M9 18l6-6-6-6" stroke-width="2"/>
      </svg>
    </button>
  </div>
</div>

<style>
      .flickity-slider-{{ section.id }} .carousel-cell {
    width: calc((100% - 40px) / 3);
    margin-right: 20px;
  }

  @media (max-width: 989px) {
    .flickity-slider-{{ section.id }} .carousel-cell {
      width: calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 749px) {
    .flickity-slider-{{ section.id }} .carousel-cell {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('.carousel-main-{{ section.id }}');
    var flkty = new Flickity(slider, {
      wrapAround: true,
      pageDots: false,
      prevNextButtons: false,
      contain: true,
      cellAlign: 'left',
    });

    const prevBtn = document.querySelector('.flickity-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.flickity-next-{{ section.id }}');

    const moveBy = () => {
      if (window.innerWidth <= 749) return 1;
      if (window.innerWidth <= 989) return 2;
      return 3;
    };

    prevBtn.addEventListener('click', () => {
      flkty.previous(moveBy());
    });

    nextBtn.addEventListener('click', () => {
      flkty.next(moveBy());
    });
  });
</script>
{% schema %}
{
  "name": "CollectionFlickity slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 20
    }
  ],
  "presets": [
    {
      "name": "CollectionFlickity slider"
    }
  ]
}
{% endschema %}
